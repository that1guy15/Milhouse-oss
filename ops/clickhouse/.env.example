# Copy to `.env` (git-ignored) and set real values. NEVER commit a real password.
# Loopback-only reference ClickHouse for local development — not a production deployment.

# Dedicated ClickHouse application account created by the compose file. Choose a non-empty password.
MILHOUSE_CLICKHOUSE_APP_USER=milhouse
MILHOUSE_CLICKHOUSE_APP_PASSWORD=

# What the Milhouse CLI resolves from your app config's [storage.clickhouse] *_env references.
# The URL is the loopback HTTP endpoint; user/password must match the two values above.
MILHOUSE_CLICKHOUSE_URL=http://127.0.0.1:8123
MILHOUSE_CLICKHOUSE_USER=milhouse
MILHOUSE_CLICKHOUSE_PASSWORD=
